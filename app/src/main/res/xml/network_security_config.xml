<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Android's <domain> element does NOT support CIDR notation like
        "192.168.0.0/16" — it only matches literal domain names or specific
        IP addresses. So we cannot whitelist a subnet.
        
        Instead, we use <base-config> with cleartextTrafficPermitted="true"
        to allow HTTP (not HTTPS) traffic for ALL destinations.
        
        This is acceptable for an internal ERP app that talks to a LAN server.
        If we add cloud relay (HTTPS) later, the system will still trust
        system CA certs (we keep <trust-anchors><certificates src="system"/>).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
